__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# Local contamination markers (machine-specific, never committed).
local-markers.txt

# Scoring run outputs (runs/<UTC-stamp>-<corpus8>-<registry8>/). Derived, and
# reproducible from the corpus plus the registry — `report --verify` proves it —
# so there is nothing to gain from versioning them. runs/isolation/ is not
# derived and stays tracked.
runs/2[0-9][0-9][0-9][0-9][0-9][0-9][0-9]T*/

# Judge answer cache (cache/judge/<key[:2]>/<key>.json). Derived: every entry
# is reproducible by re-asking the judge, and the key carries the whole recipe,
# so there is nothing to gain from versioning it — and a lot of noise to lose.
cache/
